# GENERATED by ledger-devtools sync from manifest.toml: edit the manifest, then run `uv run ledger-devtools sync`.

[importlinter]
root_packages =
    ledger_app_api
    ledger_app_migrate
    ledger_app_receiver
    ledger_app_signer
    ledger_app_worker
    ledger_country_do
    ledger_country_do_testing
    ledger_devtools
    ledger_fiscal
    ledger_fiscal_kit
    ledger_identity
    ledger_invoicing
    ledger_kernel
    ledger_platform
    ledger_signer
    ledger_testing
include_external_packages = True

[importlinter:contract:workspace-layers]
name = Workspace layers
type = layers
layers =
    ledger_app_api | ledger_app_migrate | ledger_app_receiver | ledger_app_signer | ledger_app_worker
    ledger_fiscal
    ledger_signer
    ledger_invoicing
    ledger_identity
    ledger_country_do
    ledger_fiscal_kit
    ledger_platform
    ledger_kernel

[importlinter:contract:kernel-is-stdlib-only]
name = Kernel is standard library only
type = forbidden
source_modules =
    ledger_kernel
forbidden_modules =
    alembic
    boto3
    botocore
    cryptography
    fastapi
    google
    granian
    grpc
    grpc_tools
    httpx
    hypothesis
    joserfc
    ledger_testing
    lxml
    multipart
    mypy_protobuf
    opentelemetry
    pathspec
    prometheus_client
    psycopg
    py
    pydantic
    pydantic_settings
    pytest
    python_multipart
    reportlab
    segno
    signxml
    sqlalchemy
    starlette
    structlog
    testcontainers
    types_boto3_s3
    tzdata
    xdist
    xmlschema

[importlinter:contract:platform-layers]
name = Platform layers
type = layers
containers =
    ledger_platform
exhaustive = True
layers =
    runtime
    http | grpc
    events | jobs
    auth
    data | blobs
    observability
    _manifest
    config

