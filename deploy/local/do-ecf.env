# Channel do-ecf-v1 in the local stack (LEDGER_DO_ECF_*, countries/do/src/ledger_country_do/channels/ecf_v1/settings.py),
# read by the api, the worker and the receiver: one file, so the three agree (the QR every document prints names
# DGII's hosts). No secret is in it.
# DGII's hosts: the fake DGII of this stack (compose's fake-dgii, plain http on a service name, which do-ecf-v1
# allows for TesteCF and CerteCF only; the live environment is DGII's own hosts, always).
LEDGER_DO_ECF_ECF_HOST=http://fake-dgii:8471
LEDGER_DO_ECF_FC_HOST=http://fake-dgii:8471
# Where the receiver would be reached from the internet, for the URLs each company registers with DGII: no
# enrollment activates without it. `.localhost` names this machine; nothing outside it reaches the stack.
LEDGER_DO_ECF_RECEIVER_PUBLIC_URL=https://receiver.ledger.localhost
