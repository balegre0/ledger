# Every app of the local stack (api, worker, migrate): one Settings class, so one file. A token is checked against
# the local Zitadel (compose profile `zitadel`); deploy/local/zitadel/bootstrap.sh writes zitadel/.local/ledger.env
# with the real audience, which compose reads after this file. Without Zitadel the api still starts: keys are
# fetched on the first token. Per app, compose adds LEDGER_DATABASE_DIRECT_URL (worker: LISTEN; migrate: the
# migrator login). No transaction pooler runs locally: LEDGER_DATABASE_POOLED=false.
LEDGER_ENVIRONMENT=local
LEDGER_LOG_FORMAT=json
LEDGER_DATABASE_URL=postgresql+psycopg://ledger_app:ledger_app@postgres:5432/ledger
LEDGER_DATABASE_POOLED=false
LEDGER_TOKEN_ISSUER=http://zitadel.localhost:8080
LEDGER_TOKEN_AUDIENCE=ledger-local
LEDGER_TOKEN_JWKS_URL=http://zitadel.localhost:8080/oauth/v2/keys
# The legal archive (§6.8) as write-once files: local, staging and certification runs (production refuses it).
# /archive is the containers' directory: nothing writes to it until the DO channel archives (v2-M3b Task 18), and
# its volume (owned by uid 65532: the root file system is read-only) arrives with Task 26. An app run on the host
# must set LEDGER_ARCHIVE_PATH to an absolute directory of the host, or unset LEDGER_ARCHIVE_BACKEND.
LEDGER_ARCHIVE_BACKEND=file
LEDGER_ARCHIVE_PATH=/archive
