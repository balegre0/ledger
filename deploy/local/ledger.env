# Every app of the local stack (api, worker, migrate): one Settings class, so one file. A token is checked against
# the local Zitadel (compose profile `zitadel`); deploy/local/zitadel/bootstrap.sh writes zitadel/.local/ledger.env
# with the real audience, which compose reads after this file. Without Zitadel the api still starts: keys are
# fetched on the first token. Per app, compose adds LEDGER_DATABASE_DIRECT_URL (worker: LISTEN; migrate: the
# migrator login). No transaction pooler runs locally: LEDGER_DATABASE_POOLED=false.
LEDGER_ENVIRONMENT=local
LEDGER_LOG_FORMAT=json
LEDGER_DATABASE_URL=postgresql+psycopg://ledger_app:ledger_app@postgres:5432/ledger
LEDGER_DATABASE_POOLED=false
LEDGER_TOKEN_ISSUER=http://zitadel.localhost:8080
LEDGER_TOKEN_AUDIENCE=ledger-local
LEDGER_TOKEN_JWKS_URL=http://zitadel.localhost:8080/oauth/v2/keys
# The legal archive (§6.8) as write-once files: local, staging and certification runs (production refuses it).
# /archive is the containers' directory: nothing writes to it until the DO channel archives (v2-M3b Task 18), and
# its volume (owned by uid 65532: the root file system is read-only) arrives with Task 26. An app run on the host
# must set LEDGER_ARCHIVE_PATH to an absolute directory of the host (without an archive, the DO channel does not
# start: unset LEDGER_ARCHIVE_BACKEND only for an app without it).
LEDGER_ARCHIVE_BACKEND=file
LEDGER_ARCHIVE_PATH=/archive
# The S3 backend, production's (object lock in compliance mode), against the compose profile `localstack`: set
#   LEDGER_ARCHIVE_BACKEND=s3, LEDGER_ARCHIVE_BUCKET=ledger-archive, LEDGER_ARCHIVE_REGION=us-east-1,
#   LEDGER_ARCHIVE_ENDPOINT_URL=http://localstack:4566 (http://127.0.0.1:4566 from the host; refused in staging
#   and production, whose S3 is AWS's), and unset LEDGER_ARCHIVE_PATH.
# Credentials are never LEDGER_* settings: AWS's chain reads AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# (LocalStack takes `test` for both), a profile, or a role.
# Channel do-ecf-v1 (LEDGER_DO_ECF_*, countries/do/src/ledger_country_do/channels/ecf_v1/settings.py): DGII's own
# hosts by default (the fake DGII's come with Task 26). The worker requires LEDGER_DO_ECF_TRUSTED_ROOTS, a PEM file
# of the authorities counterparties chain to: compose sets it for the worker and mounts the development root
# deploy/local/do/roots.sh writes (once, before the first `up`); a deployment's roots are the owner's (Owner item
# 7). Without LEDGER_DO_ECF_RECEIVER_PUBLIC_URL every enrollment requires it (`receiver_url`).
